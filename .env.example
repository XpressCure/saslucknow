MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/
SAS_DATABASE_NAME=sas_lucknow
SAS_ORGANISATION_KEY=sas-lucknow
PARTICIPATION_PORT=3002

# One-time code used only to activate the first administrator password.
# Use a long random value in production and remove it after activation.
SAS_ADMIN_ACTIVATION_CODE=
SAS_DOCUMENT_STORAGE_DIR=/var/lib/saslucknow-participation/documents

# Add live payment credentials only in the server environment or secret manager.
# Never expose Razorpay secrets to the browser or commit them to Git.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

